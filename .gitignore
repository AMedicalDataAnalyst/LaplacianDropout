# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Large training artifacts — too big for git (regenerate by training).
# Each is multi-GB.
checkpoints/
cifar_snapshots/
imagenette_cache/
cifar10/
*.pt
*.pth
*.pth.tar
*.ckpt

# Large data tarballs (download per docs/DATA_SETUP.md; never commit)
*.tar
*.tar.gz
*.tar.xz
*.zip

# Active log being written by the in-flight 3-seed Imagenette run.
# Gets moved to logs/phase2/ after the run finishes.
run_imagenette_3seed.log

# IDE / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code internal state (not source)
.claude/

# Local-only environment files (none currently, but defensive)
.env
.env.*
credentials*
*.key

# Auto-generated by build_report.py — keep the source data
# (results/phase1_imagenette_full/), not the regenerated report
# (which we commit a static copy of in docs/, but allow regeneration).
# (No exclude here; we DO commit docs/tier1_report.md as a snapshot.)
